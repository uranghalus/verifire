generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  MANAGER
  INSPECTOR
  VIEWER
}

enum Regu {
  PAGI
  SIANG
  MALAM
  MIDDLE
}

enum JenisApar {
  CO2
  POWDER
  FOAM
  AIR
}

enum DeviceType {
  APAR
  HYDRANT
}

enum InspectionResult {
  PASSED
  FAILED
  PENDING
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // optional, only if you use Credentials provider
  role          Role      @default(USER)
  is_active     Boolean   @default(true)

  accounts Account[]
  sessions Session[]

  apars                      Apar[]                    @relation("user_apar")
  hydrants                   Hydrant[]                 @relation("user_hydrant")
  inspections                Inspection[]              @relation("user_inspections")
  apar_inspection_details    AparInspectionDetail[]    @relation("user_apar_detail")
  hydrant_inspection_details HydrantInspectionDetail[] @relation("user_hydrant_detail")
  notifications              Notification[]
  audits                     Audit[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/**
 * DEVICES
 */
model Apar {
  id        Int       @id @default(autoincrement())
  kode_apar String    @unique
  lantai    String?
  lokasi    String
  jenis     JenisApar
  size      Float

  user_id String?
  user    User?   @relation("user_apar", fields: [user_id], references: [id], onDelete: SetNull)

  inspections AparInspectionDetail[]

  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  inspection Inspection[]
}

model Hydrant {
  id           Int     @id @default(autoincrement())
  kode_unik    String  @unique
  kode_hydrant String  @unique
  ukuran       String
  lantai       String?
  lokasi       String

  user_id String?
  user    User?   @relation("user_hydrant", fields: [user_id], references: [id], onDelete: SetNull)

  inspections HydrantInspectionDetail[]

  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  inspection Inspection[]
}

/**
 * INSPECTION (meta)
 */
model Inspection {
  id Int @id @default(autoincrement())

  device_type DeviceType
  apar_id     Int?
  hydrant_id  Int?

  apar    Apar?    @relation(fields: [apar_id], references: [id], onDelete: SetNull)
  hydrant Hydrant? @relation(fields: [hydrant_id], references: [id], onDelete: SetNull)

  user_id String?
  user    User?   @relation("user_inspections", fields: [user_id], references: [id], onDelete: SetNull)

  nama_petugas     String?
  regu             Regu             @default(PAGI)
  result           InspectionResult @default(PENDING)
  notes            String?
  tanggal_inspeksi DateTime         @default(now())

  apar_detail    AparInspectionDetail?
  hydrant_detail HydrantInspectionDetail?
  photos         InspectionPhoto[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([device_type, result])
  @@index([tanggal_inspeksi])
}

/**
 * APAR DETAIL
 */
model AparInspectionDetail {
  id            Int        @id @default(autoincrement())
  inspection_id Int        @unique
  inspection    Inspection @relation(fields: [inspection_id], references: [id], onDelete: Cascade)

  apar_id Int?
  apar    Apar? @relation(fields: [apar_id], references: [id], onDelete: SetNull)

  user_id String?
  user    User?   @relation("user_apar_detail", fields: [user_id], references: [id], onDelete: SetNull)

  nama_petugas       String?
  regu               Regu      @default(PAGI)
  tanggal_kadaluarsa DateTime?
  tanggal_refill     DateTime?
  kondisi            String?
  catatan            String?
  foto_apar          String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

/**
 * HYDRANT DETAIL
 */
model HydrantInspectionDetail {
  id            Int        @id @default(autoincrement())
  inspection_id Int        @unique
  inspection    Inspection @relation(fields: [inspection_id], references: [id], onDelete: Cascade)

  hydrant_id Int?
  hydrant    Hydrant? @relation(fields: [hydrant_id], references: [id], onDelete: SetNull)

  user_id String?
  user    User?   @relation("user_hydrant_detail", fields: [user_id], references: [id], onDelete: SetNull)

  nama_petugas               String?
  regu                       Regu    @default(PAGI)
  valve_machino_coupling     String?
  fire_hose_machino_coupling String?
  selang_hydrant             String?
  noozle_hydrant             String?
  kaca_box_hydrant           String?
  kunci_box_hydrant          String?
  box_hydrant                String?
  alarm                      String?
  foto_hydrant               String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

/**
 * PHOTOS - multi foto per inspeksi
 */
model InspectionPhoto {
  id            Int        @id @default(autoincrement())
  inspection_id Int
  inspection    Inspection @relation(fields: [inspection_id], references: [id], onDelete: Cascade)
  url           String
  type          String? // 'before' | 'after' | 'detail'
  created_at    DateTime   @default(now())

  @@index([inspection_id])
}

/**
 * NOTIFICATIONS & AUDIT
 */
model Notification {
  id      Int     @id @default(autoincrement())
  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: SetNull)
  title   String
  body    String
  is_read Boolean @default(false)
  meta    Json?

  created_at DateTime @default(now())
}

model Audit {
  id        Int     @id @default(autoincrement())
  user_id   String?
  user      User?   @relation(fields: [user_id], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entity_id String?
  before    Json?
  after     Json?

  created_at DateTime @default(now())
}
