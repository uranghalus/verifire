// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =====================
// ENUMS
// =====================
enum Role {
  USER
  ADMIN
  MANAGER
  INSPECTOR
  VIEWER
}

enum Regu {
  PAGI
  SIANG
  MALAM
  MIDDLE
}

enum JenisApar {
  CO2
  POWDER
  FOAM
  AIR
}

enum DeviceType {
  APAR
  HYDRANT
}

enum InspectionResult {
  PASSED
  FAILED
  PENDING
}

// =====================
// AUTH MODELS (NextAuth compatible)
// =====================
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  password      String? // optional, for credentials provider
  role          Role      @default(USER)
  is_active     Boolean   @default(true)

  // NextAuth relations
  accounts Account[]
  sessions Session[]

  // app relations
  apars                      apar[]                      @relation("user_apar")
  hydrants                   hydrant[]                   @relation("user_hydrant")
  inspections                inspection[]                @relation("user_inspections")
  apar_inspection_details    apar_inspection_detail[]    @relation("user_apar_detail")
  hydrant_inspection_details hydrant_inspection_detail[] @relation("user_hydrant_detail")
  notifications              notification[]
  audits                     audit[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// =====================
// LOCATION: MALL -> FLOOR -> ZONE
// =====================
model mall {
  id      Int     @id @default(autoincrement())
  name    String
  address String?

  floors floor[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model floor {
  id      Int    @id @default(autoincrement())
  name    String
  mall_id Int
  mall    mall   @relation(fields: [mall_id], references: [id], onDelete: Cascade)

  zones zone[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model zone {
  id       Int    @id @default(autoincrement())
  name     String
  floor_id Int
  floor    floor  @relation(fields: [floor_id], references: [id], onDelete: Cascade)

  apars    apar[]
  hydrants hydrant[]

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

// =====================
// APAR (sesuai Laravel)
// =====================
model apar {
  id        Int       @id @default(autoincrement())
  kode_apar String    @unique
  lantai    String?
  lokasi    String
  jenis     JenisApar
  size      Float

  user_id String?
  user    User?   @relation("user_apar", fields: [user_id], references: [id], onDelete: SetNull)

  zone_id Int?
  zone    zone? @relation(fields: [zone_id], references: [id], onDelete: SetNull)

  // relations
  inspections apar_inspection_detail[]

  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  inspection inspection[]
}

// =====================
// HYDRANT (sesuai Laravel)
// =====================
model hydrant {
  id           Int     @id @default(autoincrement())
  kode_unik    String  @unique
  kode_hydrant String  @unique
  ukuran       String
  lantai       String?
  lokasi       String

  user_id String?
  user    User?   @relation("user_hydrant", fields: [user_id], references: [id], onDelete: SetNull)

  zone_id Int?
  zone    zone? @relation(fields: [zone_id], references: [id], onDelete: SetNull)

  // relations
  inspections hydrant_inspection_detail[]

  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt
  inspection inspection[]
}

// =====================
// INSPECTIONS (generik)
// - menyimpan meta inspeksi
// - bisa menunjuk ke apar_id atau hydrant_id (opsional)
// - inspeksi detail berada di tabel terpisah
// =====================
model inspection {
  id Int @id @default(autoincrement())

  device_type DeviceType
  apar_id     Int? // if device_type = APAR
  hydrant_id  Int? // if device_type = HYDRANT

  // relations to device (optional)
  apar    apar?    @relation(fields: [apar_id], references: [id], onDelete: SetNull)
  hydrant hydrant? @relation(fields: [hydrant_id], references: [id], onDelete: SetNull)

  user_id String? // pemeriksa if linked to users table
  user    User?   @relation("user_inspections", fields: [user_id], references: [id], onDelete: SetNull)

  nama_petugas     String? // free input name
  regu             Regu             @default(PAGI)
  result           InspectionResult @default(PENDING)
  notes            String?
  photos           String? // JSON string or path (single) - adapt as needed
  tanggal_inspeksi DateTime         @default(now())

  // one-to-one to specific details
  apar_detail    apar_inspection_detail?
  hydrant_detail hydrant_inspection_detail?

  created_at DateTime @default(now())
  updated_at DateTime @default(now()) // keep updated_at for consistency
}

// =====================
// APAR INSPECTION DETAIL (detail terstruktur)
// =====================
model apar_inspection_detail {
  id            Int        @id @default(autoincrement())
  inspection_id Int        @unique
  inspection    inspection @relation(fields: [inspection_id], references: [id], onDelete: Cascade)

  apar_id Int?
  apar    apar? @relation(fields: [apar_id], references: [id], onDelete: SetNull)

  user_id String?
  user    User?   @relation("user_apar_detail", fields: [user_id], references: [id], onDelete: SetNull)

  // fields sesuai Laravel
  nama_petugas       String?
  regu               Regu      @default(PAGI)
  tanggal_kadaluarsa DateTime?
  tanggal_refill     DateTime?
  kondisi            String?
  catatan            String?
  foto_apar          String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

// =====================
// HYDRANT INSPECTION DETAIL (detail terstruktur)
// =====================
model hydrant_inspection_detail {
  id            Int        @id @default(autoincrement())
  inspection_id Int        @unique
  inspection    inspection @relation(fields: [inspection_id], references: [id], onDelete: Cascade)

  hydrant_id Int?
  hydrant    hydrant? @relation(fields: [hydrant_id], references: [id], onDelete: SetNull)

  user_id String?
  user    User?   @relation("user_hydrant_detail", fields: [user_id], references: [id], onDelete: SetNull)

  // fields sesuai Laravel example
  nama_petugas               String?
  regu                       Regu    @default(PAGI)
  valve_machino_coupling     String?
  fire_hose_machino_coupling String?
  selang_hydrant             String?
  noozle_hydrant             String?
  kaca_box_hydrant           String?
  kunci_box_hydrant          String?
  box_hydrant                String?
  alarm                      String?
  foto_hydrant               String?

  created_at DateTime @default(now())
  updated_at DateTime @default(now())
}

// =====================
// NOTIFICATIONS & AUDIT
// =====================
model notification {
  id      Int     @id @default(autoincrement())
  user_id String?
  user    User?   @relation(fields: [user_id], references: [id], onDelete: SetNull)
  title   String
  body    String
  is_read Boolean @default(false)
  meta    Json?

  created_at DateTime @default(now())
}

model audit {
  id        Int     @id @default(autoincrement())
  user_id   String?
  user      User?   @relation(fields: [user_id], references: [id], onDelete: SetNull)
  action    String
  entity    String
  entity_id String?
  before    Json?
  after     Json?

  created_at DateTime @default(now())
}
